{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xulongwu4/pi-lazy-loader/blob/main/lazy-loader.schema.json",
  "title": "pi-lazy-loader configuration",
  "type": "object",
  "required": ["packages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "packages": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["source"],
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "commands": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "tools": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        ]
      }
    }
  }
}
