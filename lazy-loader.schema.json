{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xulongwu4/pi-lazy-loader/blob/main/lazy-loader.schema.json",
  "title": "pi-lazy-loader configuration (standalone lazy-loader.json, or the \"lazy-loader\" object inside settings.json)",
  "type": "object",
  "required": ["packages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "packages": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["source"],
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "commands": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "tools": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "loadOnToolCall": {
                "description": "Tool names (exact match) that load and await this package before they execute.",
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "toolExposure": {
                "description": "Exposure override: one exposure for every tool the package registers, or per tool by exact name. Applies to direct/codemode/deferred tools only; hidden and model-only tools are never promoted.",
                "oneOf": [
                  { "enum": ["direct", "codemode", "deferred", "hidden"] },
                  {
                    "type": "object",
                    "propertyNames": { "minLength": 1 },
                    "additionalProperties": { "enum": ["direct", "codemode", "deferred", "hidden"] }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
