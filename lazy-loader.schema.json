{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xulongwu4/pi-lazy-loader/blob/main/lazy-loader.schema.json",
  "title": "pi-lazy-loader configuration (standalone lazy-loader.json, or the \"lazy-loader\" object inside settings.json)",
  "type": "object",
  "required": ["packages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "packages": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["source"],
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "commands": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "tools": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "toolExposure": {
                "description": "Per-tool exposure override by exact tool name. Applies to direct/codemode/deferred tools only; hidden and model-only tools are never promoted.",
                "type": "object",
                "propertyNames": { "minLength": 1 },
                "additionalProperties": { "enum": ["direct", "codemode", "deferred", "hidden"] }
              }
            }
          }
        ]
      }
    }
  }
}
