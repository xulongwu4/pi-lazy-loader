{
  "name": "pi-lazy-loader",
  "version": "0.1.1",
  "description": "On-demand extension loader for Pi coding agent",
  "repository": "github:xulongwu4/pi-lazy-loader",
  "homepage": "https://github.com/xulongwu4/pi-lazy-loader#readme",
  "bugs": "https://github.com/xulongwu4/pi-lazy-loader/issues",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "manifest.json",
    "src",
    "README.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "bun checks/run-checks.ts"
  },
  "dependencies": {
    "jiti": "^2.4.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  }
}
