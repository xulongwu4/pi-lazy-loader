{
  "name": "pi-lazy-loader",
  "version": "0.1.0",
  "description": "Lazy extension loader for Pi coding agent",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "manifest.json",
    "src",
    "README.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
